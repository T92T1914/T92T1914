        "source_paths": [
          "README.md",
          "docs/contract.md"
        ],
        "cards": [
          "Unequal groups",
          "Softmax weights",
          "One vector per group"
        ],
        "footer": "First-order training illustration. Empty groups return zeros.",
        "essential_text": "Weights [0.25, 0.75] combine [2, 0] and [0, 4] into [0.5, 3]. Empty groups return zero vectors. This conceptual training route does not describe every qualified derivative composition.",
        "page": "https://t92t1914.github.io/ragged-pool/"
      },
      {
