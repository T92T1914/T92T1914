        ],
        "cards": [
          "Values + mask",
          "Own input + output",
          "7.0 after return"
        ],
        "footer": "Cancellation intent does not establish physical completion.",
        "essential_text": "For values [2, -3, 5] and mask [1, 0, 1], the ordinary uncancelled sum is 7.0. Running storage stays owned until physical return.",
        "page": "https://t92t1914.github.io/heterogeneous-batch-runtime/"
      },
      {
        "id": "ragged",
        "title": "Ragged Pooling for PyTorch",
        "repository": "ragged-pool",
