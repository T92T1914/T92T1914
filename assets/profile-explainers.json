        ],
        "cards": [
          "Saved model state",
          "10,000 simulations",
          "Spark: reward 0.532"
        ],
        "footer": "Retained shaped reward, not win probability or a new search.",
        "essential_text": "The retained decision ranks Spark at mean shaped reward 0.532 after 10,000 simulations. This is one modeled decision, not an encounter win rate.",
        "page": "https://t92t1914.github.io/mcts-combat-engine/"
      },
